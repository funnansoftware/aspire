{
    "name": "aspire",
    "version-string": "2026.8.10",
    "port-version": 1,
    "description": "Personal integration and rendering engine.",
    "homepage": "https://github.com/funnansoftware/aspire",
    "dependencies": [
        {
            "name": "sdl3",
            "default-features": false,
            "features": [
                {
                    "name": "vulkan",
                    "platform": "linux | android"
                },
                {
                    "name": "wayland",
                    "platform": "linux"
                },
                {
                    "name": "x11",
                    "platform": "linux"
                }
            ]
        },
        {
            "name": "glslang",
            "host": true,
            "default-features": false,
            "features": [
                "tools"
            ],
            "platform": "!android & !emscripten"
        },
        "gtest",
        "nameof",
        "nlohmann-json",
        {
            "name": "sdl3-ttf",
            "features": [
                "harfbuzz"
            ],
            "platform": "!android"
        },
        {
            "name": "spirv-cross",
            "host": true,
            "platform": "!android & !emscripten"
        }
    ],
    "default-features": [
        "ibus"
    ],
    "features": {
        "ibus": {
            "description": "IBus input-method support for SDL3 on Linux.",
            "dependencies": [
                {
                    "name": "sdl3",
                    "default-features": false,
                    "features": [
                        "ibus"
                    ],
                    "platform": "linux"
                }
            ]
        }
    }
}
