{
    "name": "aspire",
    "version-string": "2026.8.10",
    "port-version": 1,
    "description": "Personal integration and rendering engine.",
    "homepage": "https://github.com/funnansoftware/aspire",
    "dependencies": [
        {
            "name": "sdl3",
            "default-features": false,
            "features": [
                {
                    "name": "wayland",
                    "platform": "linux"
                },
                {
                    "name": "x11",
                    "platform": "linux"
                }
            ]
        },
        "gtest",
        "nameof",
        "nlohmann-json"
    ],
    "default-features": [
        "ibus"
    ],
    "features": {
        "ibus": {
            "description": "IBus input-method support for SDL3 on Linux. Its D-Bus and systemd dependencies do not build against the Steam Runtime sniper glibc, so the SteamOS preset turns it off.",
            "dependencies": [
                {
                    "name": "sdl3",
                    "default-features": false,
                    "features": [
                        "ibus"
                    ],
                    "platform": "linux"
                }
            ]
        }
    }
}
