cmake_minimum_required(VERSION 4.4.3)

if(ASPIRE_TIDY_ERROR)
    message(FATAL_ERROR "${ASPIRE_TIDY_ERROR}")
endif()

foreach(_input IN ITEMS ASPIRE_TIDY_SOURCE_DIR ASPIRE_TIDY_BINARY_DIR ASPIRE_TIDY_EXECUTABLE ASPIRE_TIDY_PYTHON ASPIRE_TIDY_SCRIPT ASPIRE_TIDY_JOBS)
    if(NOT DEFINED ${_input} OR "${${_input}}" STREQUAL "")
        message(FATAL_ERROR "clang-tidy requires ${_input}.")
    endif()
endforeach()

if(NOT ASPIRE_TIDY_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "ASPIRE_CLANG_TIDY_JOBS must be a positive integer.")
endif()
foreach(_tool IN ITEMS ASPIRE_TIDY_EXECUTABLE ASPIRE_TIDY_PYTHON ASPIRE_TIDY_SCRIPT)
    if(NOT EXISTS "${${_tool}}" OR IS_DIRECTORY "${${_tool}}")
        message(FATAL_ERROR "Missing ${_tool}: ${${_tool}}. Reconfigure the build with the installed LLVM/Python tools.")
    endif()
endforeach()

set(_database_path "${ASPIRE_TIDY_BINARY_DIR}/compile_commands.json")
if(NOT EXISTS "${_database_path}")
    message(FATAL_ERROR "Missing ${_database_path}. Configure with CMAKE_EXPORT_COMPILE_COMMANDS=ON and build the project before running clang-tidy.")
endif()
file(REAL_PATH "${ASPIRE_TIDY_SOURCE_DIR}" _source_root)
file(REAL_PATH "${ASPIRE_TIDY_BINARY_DIR}" _binary_root)
set(_database_path "${_binary_root}/compile_commands.json")

file(READ "${_database_path}" _database)
string(JSON _type ERROR_VARIABLE _error TYPE "${_database}")
if(NOT _error STREQUAL "NOTFOUND" OR NOT _type STREQUAL "ARRAY")
    message(FATAL_ERROR "Invalid compilation database ${_database_path}: expected a JSON array. ${_error}")
endif()
string(JSON _entry_count LENGTH "${_database}")
set(_sources)
set(_source_keys)
set(_src_root "${_source_root}/src")
set(_app_root "${_source_root}/app")

if(_entry_count GREATER 0)
    math(EXPR _last_entry "${_entry_count} - 1")
    foreach(_index RANGE ${_last_entry})
        foreach(_field IN ITEMS file directory)
            string(JSON _${_field} ERROR_VARIABLE _error GET "${_database}" ${_index} ${_field})
            if(NOT _error STREQUAL "NOTFOUND")
                message(FATAL_ERROR "Invalid compilation database entry ${_index}: ${_error}")
            endif()
        endforeach()
        file(TO_CMAKE_PATH "${_directory}" _directory)
        cmake_path(ABSOLUTE_PATH _directory BASE_DIRECTORY "${_binary_root}" NORMALIZE)
        file(TO_CMAKE_PATH "${_file}" _file)
        cmake_path(ABSOLUTE_PATH _file BASE_DIRECTORY "${_directory}" NORMALIZE)
        if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}")
            continue()
        endif()
        file(REAL_PATH "${_file}" _file)
        cmake_path(IS_PREFIX _src_root "${_file}" NORMALIZE _in_src)
        cmake_path(IS_PREFIX _app_root "${_file}" NORMALIZE _in_app)
        cmake_path(IS_PREFIX _binary_root "${_file}" NORMALIZE _in_binary)
        file(RELATIVE_PATH _relative "${_source_root}" "${_file}")
        string(TOLOWER "${_relative}" _relative_lower)
        if((NOT _in_src AND NOT _in_app) OR _in_binary
            OR _relative_lower MATCHES "(^|/)(build|build-[^/]*|vcpkg|vcpkg_installed|vendor|third_party|third-party)(/|$)"
            OR NOT _relative_lower MATCHES "\\.(c|cc|cpp|cxx|c\\+\\+|ixx|cppm|ccm|cxxm|c\\+\\+m)$")
            continue()
        endif()
        set(_key "${_file}")
        if(WIN32)
            string(TOLOWER "${_key}" _key)
        endif()
        if(NOT _key IN_LIST _source_keys)
            list(APPEND _source_keys "${_key}")
            list(APPEND _sources "${_file}")
        endif()
    endforeach()
endif()

list(LENGTH _sources _source_count)
if(_source_count EQUAL 0)
    message(FATAL_ERROR "No existing C/C++ sources under ${_source_root}/src or ${_source_root}/app were found in ${_database_path}.")
endif()

set(_excluded_headers [[(^|[/\\])(build|build-[^/\\]*|vcpkg|vcpkg_installed)([/\\]|$)]])
