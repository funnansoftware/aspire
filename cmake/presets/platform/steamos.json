{
    "version": 7,
    "include": [
        "../compiler/gcc.json",
        "../config/binaryDir.json",
        "../config/ninja.json",
        "../config/release.json",
        "../config/vcpkg.json",
        "../host/x64-linux.json",
        "../target/x64-steamos.json"
    ],
    "configurePresets": [
        {
            "name": "x64-steamos-gcc-release",
