{
    "version": 7,
    "include": [
        "../compiler/emcc.json",
        "../config/binaryDir.json",
        "../config/debug.json",
        "../config/ninja.json",
        "../config/release.json",
        "../config/vcpkg.json",
        "../target/wasm32-emscripten.json"
    ],
    "configurePresets": [
        {
            "name": "wasm32-emscripten-emcc-debug",
            "inherits": [
                "config-binaryDir",
                "config-debug",
                "config-ninja",
                "config-vcpkg",
                "compiler-emcc",
                "target-wasm32-emscripten"
            ]
        },
        {
            "name": "wasm32-emscripten-emcc-release",
            "inherits": [
                "config-binaryDir",
                "config-release",
                "config-ninja",
                "config-vcpkg",
                "compiler-emcc",
                "target-wasm32-emscripten"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "wasm32-emscripten-emcc-debug",
            "configurePreset": "wasm32-emscripten-emcc-debug"
        },
        {
            "name": "wasm32-emscripten-emcc-release",
            "configurePreset": "wasm32-emscripten-emcc-release"
        }
    ]
}
