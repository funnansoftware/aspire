{
    "version": 7,
    "configurePresets": [
        {
            "name": "compiler-homebrew-clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm@22/bin/clang++",
                "CMAKE_CXX_STDLIB_MODULES_JSON": "/opt/homebrew/opt/llvm@22/lib/c++/libc++.modules.json",
                "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm@22/bin/clang",
                "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror -pedantic -Wno-reserved-module-identifier -stdlib=libc++",
                "CMAKE_EXE_LINKER_FLAGS": "-L/opt/homebrew/opt/llvm@22/lib/c++ -Wl,-rpath,/opt/homebrew/opt/llvm@22/lib/c++",
                "CMAKE_C_FLAGS": "-Wall -Wextra -Werror -pedantic"
            },
            "environment": {
                "SDKROOT": "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
            }
        }
    ]
}
