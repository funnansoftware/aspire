{
    "version": 7,
    "configurePresets": [
        {
            "name": "compiler-emcc",
            "hidden": true,
            "environment": {
                "EMSDK": "${sourceDir}/.emsdk",
                "EMSCRIPTEN_ROOT": "${sourceDir}/.emsdk/upstream/emscripten",
                "EM_CONFIG": "${sourceDir}/.emsdk/.emscripten",
                "EM_CACHE": "${sourceDir}/.emsdk/upstream/emscripten/cache"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_CXX_FLAGS": "-Wall -Wextra -Werror -pedantic -Wno-reserved-module-identifier",
                "CMAKE_C_FLAGS": "-Wall -Wextra -Werror -pedantic",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/toolchains/emscripten.cmake"
            }
        }
    ]
}
