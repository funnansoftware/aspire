{
    "version": 7,
    "configurePresets": [
        {
            "name": "compiler-msvc",
            "hidden": true,
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "environment": {
                "ASPIRE_MSVC_DIR": "$penv{VCToolsInstallDir}"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_CXX_COMPILER": "cl",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_RC_COMPILER": "rc",
                "CMAKE_MT": "mt",
                "CMAKE_CXX_FLAGS": "/MP /permissive- /W4 /WX /EHsc /Zc:preprocessor /utf-8"
            }
        }
    ]
}
