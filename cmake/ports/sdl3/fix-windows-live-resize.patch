+        if (data->in_modal_loop && !WIN_in_live_resize_update) {
+            /* The compositor shows the window's new size and place from its next composition, not as SetWindowPos
+             * returns, so the frame waits for it. Drawn sooner, it was still shown first about one time in three. */
+            if (data->videodata->DwmFlush && SDL_GetHintBoolean(SDL_HINT_WINDOWS_LIVE_RESIZE_DWMFLUSH, true)) {
+                data->videodata->DwmFlush();
+            }
+            WIN_LiveResizeUpdate(data->window);
+        }
+        return 0;
+    }
+#endif
