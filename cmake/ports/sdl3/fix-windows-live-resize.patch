+#if !defined(SDL_PLATFORM_XBOXONE) && !defined(SDL_PLATFORM_XBOXSERIES)
+// Whether the app's drawing a frame for a window being moved or resized, so a window change it makes doesn't ask again.
+static bool WIN_in_live_resize_update = false;
+
+static void WIN_LiveResizeUpdate(SDL_Window *window)
+{
+    if (!WIN_in_live_resize_update) {
+        WIN_in_live_resize_update = true;
+        SDL_OnWindowLiveResizeUpdate(window);
+        WIN_in_live_resize_update = false;
+    }
+}
+
+// Whether a window being resized has asked for a frame at its new size, which it draws when the message arrives.
+static bool WIN_live_resize_posted = false;
+
+// The message a window being resized posts itself, to draw a frame at its new size once the compositor has it.
+static UINT WIN_LiveResizeMessage(void)
+{
+    static UINT message = 0;
+
+    if (!message) {
+        message = RegisterWindowMessage(TEXT("SDL_LiveResizeUpdate"));
+    }
+    return message;
+}
+
+/* Whether the frame waits for the compositor's next composition, so it has the window's new size and place first.
+ * SDL took DwmFlush out of the modal loop's timer after it locked up the compositor under Steam; this hint, true by
+ * default, turns it off here too, should that happen. */
+#define SDL_HINT_WINDOWS_LIVE_RESIZE_DWMFLUSH "SDL_WINDOWS_LIVE_RESIZE_DWMFLUSH"
+#endif
+
 LRESULT CALLBACK WIN_WindowProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
