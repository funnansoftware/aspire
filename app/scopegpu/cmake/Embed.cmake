# Writes a C++ module holding scopegpu's compiled shaders, so the executable carries them.
#
# cmake -DOUTPUT=<module> -DDIRECTORY=<compiled shaders> -DSHADERS=<a.vert,b.frag,...> -DFORMATS=<spv,msl,...>
#       -DMAX_TAPS=<n> -P Embed.cmake
#
# Each shader becomes a `Blobs` named after it, `shape.vert` as `ShapeVertex`, with its code in each format. A format
# scopegpu wasn't built with is left empty.

cmake_minimum_required(VERSION 4.0)

string(REPLACE "," ";" shaders "${SHADERS}")
string(REPLACE "," ";" formats "${FORMATS}")

set(content [=[
// Generated by app/scopegpu/cmake/Embed.cmake from the compiled shaders. Do not edit.
export module scopegpu.shadercode;

import std;

export namespace scopegpu::shadercode
{
    /// @brief A shader's code in each format, empty for those scopegpu wasn't built with.
    struct Blobs
    {
        std::span<const std::uint8_t> spirv;
        std::span<const std::uint8_t> msl;
        std::span<const std::uint8_t> dxil;
        std::span<const std::uint8_t> dxbc;
    };

    /// The most taps the blur shaders take, as they were compiled.
    inline constexpr std::size_t MaxTaps = @MAX_TAPS@;

]=])

foreach(shader IN LISTS shaders)
    string(REPLACE "." ";" parts "${shader}")
    list(GET parts 0 base)
    list(GET parts 1 stage)
    string(SUBSTRING "${base}" 0 1 first)
    string(TOUPPER "${first}" first)
    string(SUBSTRING "${base}" 1 -1 rest)

    if(stage STREQUAL "vert")
        set(name "${first}${rest}Vertex")
    else()
        set(name "${first}${rest}Fragment")
    endif()

    foreach(format IN ITEMS spv msl dxil dxbc)
        if(format STREQUAL "spv")
            set(member "Spirv")
        else()
            string(SUBSTRING "${format}" 0 1 first)
            string(TOUPPER "${first}" first)
            string(SUBSTRING "${format}" 1 -1 rest)
            set(member "${first}${rest}")
        endif()

        if(NOT format IN_LIST formats)
            string(APPEND content "    inline constexpr std::array<std::uint8_t, 0> ${name}${member}{};\n")
            continue()
        endif()

        file(READ "${DIRECTORY}/${shader}.${format}" hex HEX)
        string(LENGTH "${hex}" length)
        math(EXPR bytes "${length} / 2")
        string(APPEND content "    inline constexpr std::array<std::uint8_t, ${bytes}> ${name}${member}{\n")

        # 32 bytes to a line.
        set(offset 0)
        while(offset LESS length)
            string(SUBSTRING "${hex}" ${offset} 64 chunk)
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " chunk "${chunk}")
            string(STRIP "${chunk}" chunk)
            string(APPEND content "        ${chunk}\n")
            math(EXPR offset "${offset} + 64")
        endwhile()

        string(APPEND content "    };\n")
    endforeach()

    string(APPEND content
        "    inline constexpr Blobs ${name}{.spirv = ${name}Spirv, .msl = ${name}Msl, .dxil = ${name}Dxil, .dxbc = ${name}Dxbc};\n\n")
endforeach()

string(APPEND content "}\n")

# Only a change rebuilds what imports it.
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${content}" @ONLY)
